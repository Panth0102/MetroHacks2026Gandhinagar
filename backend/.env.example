# ---- Metro Revenue Intelligence: environment configuration ----
# Copy to .env and adjust. Never commit real credentials.

APP_NAME="Metro Revenue Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS: comma-separated origins allowed to call the API (Phase 2 frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Default dev fallback is SQLite (zero setup). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/metro
DATABASE_URL=sqlite:///./metro_dev.db

TIMEZONE=Asia/Kolkata

# ---- Pricing assumptions (INDICATIVE, not market-verified) ----
# The active DB pricing_config row overrides these at runtime.
PRICING_MODEL_VERSION=v1.0-heuristic
BASE_RATE_PER_SQM=1800
BASE_PANEL_RATE=45000
REFERENCE_DAILY_FOOTFALL=20000
FOOTFALL_ELASTICITY=0.3
MIN_FOOTFALL_FACTOR=0.6
MAX_FOOTFALL_FACTOR=1.8
REFERENCE_VISIBILITY=5
VISIBILITY_WEIGHT=0.08
MIN_VISIBILITY_FACTOR=0.7
MAX_VISIBILITY_FACTOR=1.4
